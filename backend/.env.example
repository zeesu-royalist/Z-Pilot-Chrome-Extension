# Z-Pilot Backend Configuration

# Server Host (127.0.0.1 for local security, 0.0.0.0 for containerized deployment)
HOST=127.0.0.1

# Server Port
PORT=3000

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (Defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS Allowed Origins (Comma-separated list or * for local development)
# For Chrome Extensions, use chrome-extension://<EXTENSION_ID> or * in local dev
ALLOWED_ORIGINS=*

# Environment: development | production
NODE_ENV=development
